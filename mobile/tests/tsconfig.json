{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "rootDir": "..",
    "outDir": "../.test-build",
    "types": [
      "node"
    ]
  },
  "include": [
    "./**/*.ts",
    "../src/ble/protocol.ts",
    "../src/ble/client.ts"
  ]
}