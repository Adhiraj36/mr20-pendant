{
  "expo": {
    "name": "LYZN",
    "slug": "mr20-pendant",
    "version": "4.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": [
      "pendant",
      "karma",
      "lyzn"
    ],
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0B0C"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lyzn.flutter",
      "buildNumber": "3",
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "Lyzn AI connects to your pendant over Bluetooth to pull the conversations it has saved and to check its battery and storage.",
        "NSBluetoothPeripheralUsageDescription": "Lyzn AI connects to your pendant over Bluetooth to pull the conversations it has saved and to check its battery and storage.",
        "NSMicrophoneUsageDescription": "Your microphone is used only while you are talking to Mira in a voice chat. The pendant records on its own and never uses it.",
        "UIBackgroundModes": [
          "bluetooth-central",
          "audio",
          "remote-notification"
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocalNetworkUsageDescription": "Large recordings come across the pendant's own WiFi hotspot, which is far faster than pulling them over Bluetooth.",
        "NSAppTransportSecurity": {
          "NSExceptionDomains": {
            "Mr20Pe-Voice-ywyH3JiorRMG-753359449.ap-south-1.elb.amazonaws.com": {
              "NSExceptionAllowsInsecureHTTPLoads": true,
              "NSIncludesSubdomains": true
            }
          }
        }
      },
      "entitlements": {
        "com.apple.developer.networking.HotspotConfiguration": true
      }
    },
    "android": {
      "package": "com.lyzn.flutter",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#0B0B0C"
      },
      "permissions": [
