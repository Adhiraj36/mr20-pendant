{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    // @lyzn/design is ESM with .ts import specifiers (its tests run under Node type stripping); the app type-checks through them.
    "allowImportingTsExtensions": true,
    "strict": true,
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts", "nativewind-env.d.ts"],
  "exclude": ["tests", ".test-build", "node_modules"]
}
