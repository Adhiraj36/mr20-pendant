      "googleServicesFile": "./google-services.json"
    },
    "plugins": [
      "./plugins/with-android-permissions.js",
      "expo-router",
      "expo-secure-store",
      "expo-audio",
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": true,
          "modes": [
            "central"
          ],
